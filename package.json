{
  "name": "feathers-graph-populate",
  "description": "Add lightning fast, GraphQL-like populates to your FeathersJS API.",
  "version": "7.0.0",
  "homepage": "https://feathers-graph-populate.netlify.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/marshallswain/feathers-graph-populate"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "type": "module",
  "keywords": [
    "feathers",
    "feathers.js",
    "feathers-plugin",
    "hooks",
    "populate"
  ],
  "author": {
    "name": "Marshall Thompson",
    "email": "marshall@creativeideal.net"
  },
  "contributors": [],
  "bugs": {},
  "files": [
    "LICENSE",
    "README.md",
    "src/**",
    "dist/**"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "attw": "attw --pack . --ignore-rules cjs-resolves-to-esm",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build",
    "version": "pnpm build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vitest": "vitest",
    "coverage": "vitest run --coverage",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "peerDependencies": {
    "@feathersjs/feathers": "^5.0.0"
  },
  "dependencies": {
    "dequal": "^2.0.3",
    "feathers-utils": "^10.8.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@feathers-community/eslint-config": "^0.3.0",
    "@feathersjs/adapter-commons": "^5.0.50",
    "@feathersjs/errors": "^5.0.50",
    "@feathersjs/feathers": "^5.0.50",
    "@feathersjs/memory": "^5.0.50",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.3",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^5.0.2"
  }
}
